# Clave del sitio de reCAPTCHA (es publica). Copiar este archivo como .env.
# Si la dejas vacia, el login no muestra el captcha de Google y usa solo la
# proteccion local (bloqueo por intentos + captcha propio).
VITE_RECAPTCHA_SITE_KEY=6Lc2vvgtAAAAAMw5zKbYPscenDY-5nXCs9jg_A9g

# URL de la API. Si no se define, el frontend usa http://localhost:56153/api.
# Con /api las llamadas pasan por el proxy de Vite, que sirve para abrir el
# frontend desde otra maquina.
VITE_API_URL=
